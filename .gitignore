# Dependencies
/vendor/
/node_modules/
/bower_components/

# JavaScript package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment and secrets
.env
.env.*
auth.json
Homestead.json
Homestead.yaml

# Laravel generated assets and runtime files
/public/build
/public/hot
/public/storage
/public/js/filament/
/public/css/filament/
/public/fonts/filament/
/storage/*.key
/storage/logs/*
!/storage/logs/.gitignore
/storage/framework/cache/data/*
!/storage/framework/cache/data/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/testing/*
!/storage/framework/testing/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/bootstrap/cache/*.php
!/bootstrap/cache/.gitignore

# Test and tool caches
.phpunit.result.cache
/.phpunit.cache
/coverage/
/.php-cs-fixer.cache
/.pest.cache

# IDE and OS files
/.fleet
/.idea
/.vscode
.DS_Store
Thumbs.db

# Android / Capacitor local build files
/android/.gradle/
/android/local.properties
/android/build/
/android/app/build/
!/android/app/build/
/android/app/build/*
!/android/app/build/outputs/
/android/app/build/outputs/*
!/android/app/build/outputs/apk/
!/android/app/build/outputs/apk/**/*.apk
